PORT=5000
NODE_ENV=development

# Browser origin(s) allowed by CORS and Socket.IO. Comma-separated for several.
# REQUIRED when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173

# Set when running behind a reverse proxy / load balancer (number of hops, e.g. 1)
# so rate limiting sees real client IPs.
# TRUST_PROXY=1

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Optional login lockout tuning (defaults: 5 failures, 15 minute lock)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: how many database queries may run at once (default 30).
# Keep it well below the database server's max_connections.
DB_POOL_SIZE=30
